# Public extension build configuration
WXT_PUBLIC_MANAGED_ENABLED=false
WXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
WXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Operator pulse (CI/server only; never compile these into the extension)
AUTOVOX_CONTROL_PLANE_SITE_URL=https://your-deployment.convex.site
AUTOVOX_OPERATOR_SECRET=replace-with-a-random-secret

# Set these with `pnpm exec convex env set ...`, not in extension env files:
# CLERK_JWT_ISSUER_DOMAIN
# OPENROUTER_MANAGEMENT_KEY
# OPENROUTER_WORKSPACE_ID
# AUTOVOX_DAILY_BUDGET_MICRO_USD
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# STRIPE_PRICE_CREDIT_PACK_100
# CHECKOUT_SUCCESS_URL
# CHECKOUT_CANCEL_URL
# AUTOVOX_OPERATOR_SECRET
