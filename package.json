{
  "name": "autovox",
  "description": "Autovox — digest a page into a spoken news report with an LLM comprehension layer.",
  "private": true,
  "version": "0.2.0",
  "homepage": "https://chromewebstore.google.com/detail/autovox/aodlbiejdiibbpemagfngbdhaappejda",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit:chrome": "wxt submit --chrome-zip .output/*-chrome.zip",
    "release": "tsx scripts/release.ts",
    "pulse": "tsx scripts/store-pulse.ts",
    "money-pulse": "tsx scripts/money-pulse.ts",
    "economics-pulse": "tsx scripts/economics-pulse.ts",
    "compile": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm compile && pnpm test && pnpm build",
    "convex:dev": "convex dev",
    "convex:check": "convex dev --once",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@clerk/chrome-extension": "3.1.81",
    "@convex-dev/stripe": "0.1.6",
    "@mozilla/readability": "^0.6.0",
    "convex": "1.45.0",
    "convex-helpers": "0.1.123",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "4.0.0",
    "@types/mozilla-readability": "^0.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "10.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "^8.2.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
