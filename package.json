{
  "name": "autovox",
  "description": "Autovox — digest a page into a spoken news report with an LLM comprehension layer.",
  "private": true,
  "version": "0.1.1",
  "homepage": "https://chromewebstore.google.com/detail/autovox/aodlbiejdiibbpemagfngbdhaappejda",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit:chrome": "wxt submit --chrome-zip .output/*-chrome.zip",
    "release": "tsx scripts/release.ts",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/mozilla-readability": "^0.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
